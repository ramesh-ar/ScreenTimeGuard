// Merge this into the existing android/app/build.gradle generated by
// `npx react-native init`. It adds a release signing config driven by
// environment variables so the GitHub Actions workflow can sign builds
// without secrets ever being committed to the repo.

android {
    ...

    signingConfigs {
        release {
            if (System.getenv("RELEASE_STORE_FILE")) {
                storeFile file(System.getenv("RELEASE_STORE_FILE"))
                storePassword System.getenv("RELEASE_STORE_PASSWORD")
                keyAlias System.getenv("RELEASE_KEY_ALIAS")
                keyPassword System.getenv("RELEASE_KEY_PASSWORD")
            }
        }
    }

    buildTypes {
        release {
            signingConfig = System.getenv("RELEASE_STORE_FILE") ?
                signingConfigs.release : signingConfigs.debug
            minifyEnabled enableProguardInReleaseBuilds
            proguardFiles getDefaultProguardFile("proguard-android.txt"), "proguard-rules.pro"
        }
    }
}

/*
 How to create the keystore this workflow expects (run once, locally):

   keytool -genkeypair -v -storetype PKCS12 \
     -keystore release.keystore -alias screentimeguard \
     -keyalg RSA -keysize 2048 -validity 10000

 Then, in your GitHub repo settings -> Secrets and variables -> Actions,
 add these repository secrets:

   RELEASE_KEYSTORE_BASE64   -> base64 of release.keystore
                                (base64 -i release.keystore | pbcopy)
   RELEASE_STORE_PASSWORD    -> the keystore password you chose
   RELEASE_KEY_ALIAS         -> screentimeguard (or whatever alias you used)
   RELEASE_KEY_PASSWORD      -> the key password you chose

 Never commit release.keystore itself to the repo — it's already covered
 by .gitignore.
*/
