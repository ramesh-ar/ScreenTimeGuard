  This is a SNIPPET to merge into your existing AndroidManifest.xml
  (generated by `npx react-native init`). Do not replace the whole file —
  add these entries inside the existing <manifest> and <application> tags.
-->

<!-- Permissions: add inside <manifest> -->
<uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
    tool:ignore="ProtectedPermissions" />
<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
<uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
    tool:ignore="QueryAllPackagesPermission" />

<!-- Inside <application>, alongside MainActivity -->

<activity
    android:name=".modules.LockScreenActivity"
    android:exported="false"
    android:excludeFromRecents="true"
    android:launchMode="singleInstance"
    android:showOnLockScreen="true"
    android:theme="@style/Theme.AppCompat.NoActionBar" />

<service
    android:name=".modules.AppBlockAccessibilityService"
    android:exported="false"
    android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
    <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
    </intent-filter>
    <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/accessibility_service_config" />
</service>

<!-- Deep link so LockScreenActivity's "Ask a friend" button can open the RN app
     directly on the FriendUnlockScreen -->
<activity android:name=".MainActivity" ...>
    <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="screentimeguard" android:host="unlock-request" />
    </intent-filter>
</activity>
